{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KlugNetz",
  "version": "0.1.0",
  "identifier": "com.klugnetz.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "KlugNetz",
        "decorations": false,
        "transparent": true,
        "width": 1280,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Mehrnoosh Yaghoubi Kalourazi",
    "copyright": "Copyright (c) 2026 Mehrnoosh Yaghoubi Kalourazi",
    "shortDescription": "An interactive algorithms laboratory"
  }
}